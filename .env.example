# --- Required for production ---
# Long random string used to sign admin sessions (openssl rand -hex 32)
SESSION_SECRET=
# Admin login password (use a long random value)
ADMIN_PASSWORD=
# Shared secret for POST /api/sync (GitHub Actions cron and manual triggers)
SYNC_SECRET=
# Public base URL of this deployment (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Persistent shared database (Supabase). Optional: without it the app runs in
# cache-only mode (live upstream data, no admin edits, no sync history). ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstream data source (official LoL Esports) ---
# The public key used by lolesports.com itself. Override if Riot rotates it.
LOLESPORTS_API_KEY=
LOLESPORTS_LEAGUE_ID=98767975604431411
LOLESPORTS_TOURNAMENT_ID=115660540725177488

